{
  "manifest_version": 2,
  "name": "omerFlix MASTER",
  "version": "7.2",
  "description": "Gelişmiş 3D/8D Ses Motoru ve Web Koruması",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["background.js"]
  }
}
