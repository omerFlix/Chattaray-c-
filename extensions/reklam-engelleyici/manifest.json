{
  "manifest_version": 3,
  "id": "reklam-engelleyici",
  "name": "Kalkan Reklam Engelleyici",
  "version": "1.0.0",
  "description": "YouTube, haber siteleri ve tüm web sayfalarındaki reklamları, videoları ve afişleri anında engeller.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["adblock.css"],
      "js": ["adblock.js"],
      "run_at": "document_start"
    }
  ]
}
