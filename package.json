{
  "name": "chat-tarayici",
  "version": "1.0.11",
  "description": "ChatTarayıcı - Modern Web Tarayıcısı",
  "main": "main.js",
  "author": "omerFlix",
  "license": "MIT",
  "dependencies": {
    "extract-zip": "^2.0.1",
    "sql.js": "^1.15.2"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win",
    "dist:setup": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:deb": "electron-builder --linux dir && node scripts/build-deb.js",
    "dist:linux": "electron-builder --linux tar.gz && node scripts/build-deb.js",
    "dist:all": "electron-builder --win && npm run dist:deb"
  },
  "build": {
    "appId": "com.omerflix.chattarayici",
    "productName": "ChatTarayici",
    "copyright": "Copyright © 2026 omerFlix",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Network",
      "maintainer": "omerFlix",
      "executableName": "chat-tarayici",
      "synopsis": "ChatTarayıcı - Modern Web Tarayıcısı",
      "description": "ChatTarayıcı - Pardus ETAP ve Linux için Eklenti Destekli Modern Web Tarayıcısı",
      "icon": "icon.png"
    },
    "deb": {
      "priority": "optional",
      "depends": [
        "libnotify4",
        "libnss3",
        "libxss1",
        "libasound2",
        "libsecret-1-0",
        "xdg-utils"
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ChatTarayici"
    },
    "files": [
      "main.js",
      "renderer.js",
      "styles.css",
      "index.html",
      "icon.png",
      "extension-manager.js",
      "chrome-importer.js",
      "password-manager.js",
      "updater.js",
      "update-config.json",
      "package.json",
      "data/**/*",
      "extensions/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.18.0"
  }
}
